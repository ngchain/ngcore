#!/bin/sh
# Enforce Angular commit message convention.
# https://github.com/angular/angular/blob/main/contributing-docs/commit-message-guidelines.md
# Format: <type>(<scope>): <summary>
# Types: build|ci|docs|feat|fix|perf|refactor|test|style|chore|revert

msg_file="$1"
header=$(head -n1 "$msg_file")

# Allow merge/revert/fixup commits generated by git itself
case "$header" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(build|ci|docs|feat|fix|perf|refactor|test|style|chore|revert)(\([a-z0-9./*-]+\))?!?: .{1,}$'

if ! printf '%s' "$header" | grep -qE "$pattern"; then
    echo "commit-msg hook: header does not follow the Angular convention:" >&2
    echo "  $header" >&2
    echo "" >&2
    echo "Expected: <type>(<scope>): <summary>" >&2
    echo "  types: build ci docs feat fix perf refactor test style chore revert" >&2
    echo "  e.g.: fix(ngp2p): reconnect to bootstrap nodes on failure" >&2
    exit 1
fi

if [ ${#header} -gt 100 ]; then
    echo "commit-msg hook: header is ${#header} chars, max 100" >&2
    exit 1
fi

exit 0
